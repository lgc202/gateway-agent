HTTP_HOST=0.0.0.0
HTTP_PORT=8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gateway_agent
MYSQL_USERNAME=gateway_agent
MYSQL_PASSWORD=gateway_agent

HIGRESS_ENDPOINT=http://127.0.0.1:8081
HIGRESS_USERNAME=admin
HIGRESS_PASSWORD=

# 不传 model_config_id 的 Chat 使用下面的默认模型
MODEL_PROVIDER=openai
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_TOKENS=4096

AGENT_MAX_ITERATIONS=8

# 使用 `openssl rand -base64 32` 生成，生产环境通过 Secret 注入
MODEL_CONFIG_ENCRYPTION_KEY=

PRODUCT_MIGRATION_URL=mysql://gateway_agent:gateway_agent@tcp(127.0.0.1:3306)/gateway_agent?multiStatements=true
